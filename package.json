{
  "name": "canoncore",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "dev:web": "turbo run dev -F web --",
    "db:studio": "turbo run db:studio -F @canoncore/db --",
    "db:generate": "turbo run db:generate -F @canoncore/db --",
    "db:migrate": "turbo run db:migrate -F @canoncore/db --",
    "db:setup": "turbo run db:setup -F @canoncore/db --",
    "db:restore": "turbo run db:restore -F @canoncore/db --",
    "db:seed": "turbo run db:seed -F @canoncore/db --",
    "db:check-ladder": "turbo run db:check-ladder -F @canoncore/db --",
    "db:start": "turbo run db:start -F @canoncore/db --",
    "db:stop": "turbo run db:stop -F @canoncore/db --",
    "db:down": "turbo run db:down -F @canoncore/db --",
    "test:e2e": "turbo run test:e2e",
    "test:browser": "turbo run test:browser",
    "test:contract": "turbo run test:contract"
  },
  "dependencies": {
    "@canoncore/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@canoncore/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.3.4",
  "registries": {
    "@shadcnblocks": {
      "url": "https://www.shadcnblocks.com/r/{name}",
      "headers": {
        "Authorization": "Bearer ${SHADCNBLOCKS_API_KEY}"
      }
    }
  }
}
