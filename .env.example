# CanonCore's settings. Copy this file to `.env` beside `compose.yaml`:
#
#   curl -fsSL -o .env https://raw.githubusercontent.com/jacobdrees-canoncore/CanonCore/main/.env.example
#
# Compose reads `.env` from the directory it runs in, and every value below
# reaches the app through `compose.yaml`. A variable here that nothing in that
# file interpolates would be a setting that silently does nothing, which is what
# `packages/env/src/install-path.test.ts` exists to refuse.

# REQUIRED. The database password, used to create the Postgres role on first
# boot and to build the app's DATABASE_URL. Compose refuses to start without it
# rather than defaulting to something a stranger would never change.
#
# LETTERS AND DIGITS ONLY. This ends up inside a connection URI, so a password
# carrying any of : / ? # [ ] @ % makes that URI a different URI or no URI at
# all. MEASURED 2026-09-11 with `pa/ss?w#rd@123`: the container died at the
# migration on `ERR_INVALID_URL` and, under `restart: unless-stopped`, went
# round again -- a crash loop on the first run, which is the run that has to
# work without help. Generate one and the question does not arise:
#
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
#
# There is nothing to keep in step: DATABASE_URL is composed from this in
# `compose.yaml` rather than written out again here.
POSTGRES_PASSWORD=

# The hosts and address ranges CanonCore may fetch a Provider from, separated by
# commas or whitespace -- `wiki.example.com, 100.64.0.0/10`.
#
# EMPTY REFUSES EVERY PROVIDER, and that is the default on purpose (ADR-0034).
# An instance nobody has configured reaches nothing at all, rather than
# reaching whatever a response happens to name; a Provider becomes reachable by
# being named here and never by an exception carved somewhere else. So an empty
# catalogue on a fresh install is this setting rather than a fault, and the
# front page says so.
PROVIDER_ALLOWLIST=

# The Providers CanonCore searches, as their base URLs, separated by commas or
# whitespace -- `http://provider-wiki:8080, http://provider-tmdb:8080`.
#
# A SECOND SETTING BESIDE THE ALLOWLIST, because the two hold different things.
# The allowlist above holds HOSTS AND RANGES and says what MAY be reached; this
# holds the URLs themselves and says what IS reached. A Provider needs to be in
# both: named here so it is searched, and allowlisted above so the request is
# permitted.
#
# EMPTY MEANS NO PROVIDER IS SEARCHED, so the import surface says so rather than
# showing an empty result. A Provider is a URL answering the CMPP contract
# (ADR-0031) rather than code you install, so nothing here runs inside your
# catalogue.
PROVIDER_URLS=

# The password you log in with. Everything that CHANGES your catalogue is behind
# it: creating and editing an Item, placing it in a Container, reordering one,
# writing a note, importing from a Provider, purging one. Reading is not, so
# anyone you show your instance to can browse it.
#
# LEAVE IT EMPTY AND NOBODY CAN LOG IN, including you. That is the read-only
# mode the public demo runs in rather than a half-configured install, so set it
# if this instance is yours to curate. Twelve characters at least; the app
# refuses to start on a shorter one.
#
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
OWNER_PASSWORD=

# The port on this machine that CanonCore answers on. The container always
# serves 3000; this is only the host side of the mapping, for a machine where
# something already holds that port.
CANONCORE_PORT=3000
