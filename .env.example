# CanonCore's settings. Copy this file to `.env` beside `compose.yaml`:
#
#   curl -fsSL -o .env https://raw.githubusercontent.com/jacobdrees-canoncore/CanonCore/main/.env.example
#
# Compose reads `.env` from the directory it runs in, and every value below
# reaches the app through `compose.yaml`. A variable here that nothing in that
# file interpolates would be a setting that silently does nothing, which is what
# `packages/env/src/install-path.test.ts` exists to refuse.

# REQUIRED. The database password, used to create the Postgres role on first
# boot and to build the app's DATABASE_URL. Compose refuses to start without it
# rather than defaulting to something a stranger would never change.
#
# There is nothing to keep in step: DATABASE_URL is composed from this in
# `compose.yaml` rather than written out again here.
POSTGRES_PASSWORD=

# The hosts and address ranges CanonCore may fetch a Provider from, separated by
# commas or whitespace -- `wiki.example.com, 100.64.0.0/10`.
#
# EMPTY REFUSES EVERY PROVIDER, and that is the default on purpose (ADR-0034).
# An instance nobody has configured reaches nothing at all, rather than
# reaching whatever a response happens to name; a Provider becomes reachable by
# being named here and never by an exception carved somewhere else. So an empty
# catalogue on a fresh install is this setting rather than a fault, and the
# front page says so.
PROVIDER_ALLOWLIST=

# The port on this machine that CanonCore answers on. The container always
# serves 3000; this is only the host side of the mapping, for a machine where
# something already holds that port.
CANONCORE_PORT=3000
